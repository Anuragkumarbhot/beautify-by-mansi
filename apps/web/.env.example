# Public values are safe to expose to the browser. Never put service-role
# keys, database passwords, Razorpay secrets, or webhook secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Add only to trusted deployment environment settings.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
